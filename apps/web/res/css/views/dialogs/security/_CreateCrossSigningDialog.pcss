.mx_CreateCrossSigningDialog {
    width: 400px;
    border-radius: var(--cpd-space-4x);
    text-align: center;
    padding: var(--cpd-space-10x);
    outline: none;

    details .mx_AccessibleButton {
        margin: 1em 0;
    }
}

.mx_CreateCrossSigningDialog .mx_Dialog_title {
    margin-bottom: var(--cpd-space-6x);
    font-size: $font-18px;
    font-weight: var(--cpd-font-weight-semibold);
}

.mx_InitialCryptoSetup {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--cpd-space-8x);

    h2 {
        font-size: $font-18px;
        font-weight: var(--cpd-font-weight-semibold);
        margin: 0 0 var(--cpd-space-8x);
    }
}
